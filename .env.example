# Proyecto de Supabase. Se encuentran en el panel: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# ---------------------------------------------------------------------------
# Notificaciones push (opcional)
#
# Sin esto la app funciona igual y el interruptor de avisos ni siquiera aparece.
#
# Las claves VAPID se generan una sola vez con:
#
#     npx web-push generate-vapid-keys
#
# y no se cambian nunca más: al cambiarlas, todas las suscripciones existentes
# dejan de valer y hay que volver a pedir permiso teléfono por teléfono.
#
# Ojo con las tres de abajo que NO llevan `NEXT_PUBLIC_`. Ese prefijo hace que
# Next las incruste en el JavaScript que descarga cualquiera; la clave de
# servicio de Supabase se salta RLS por completo, así que publicarla es entregar
# la base entera.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un contacto al que el servicio de push pueda escribir si algo va mal. Lo exige
# el estándar. Vale un `mailto:` o una URL https.
VAPID_SUBJECT=mailto:contacto@ejemplo.org
# Clave de servicio de Supabase: Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Cualquier cadena larga y aleatoria. Es lo único que separa a un desconocido de
# poder mandarle una notificación a toda la ciudad:
#     openssl rand -base64 32
PUSH_WEBHOOK_SECRET=
